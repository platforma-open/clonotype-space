test := import("@platforma-sdk/workflow-tengo:test")
exec := import("@platforma-sdk/workflow-tengo:exec")
rf := import(":resource-formula")

f := exec.formula

// Evaluate a resource AST end-to-end against fake metric values, mirroring what
// the builder does at run time: bind tag "input" to a file, then evaluate.
// fileName picks a line-oriented name for lineCount-based (sequence) formulas
// and a parquet name for size-based (embedding) formulas.
_eval := func(ast, fileName, sizeBytes, lineCount) {
    resolved := f.resolveAst(ast, { "input": [fileName] }, [fileName])
    resolver := {
        size:      func(files) { return sizeBytes },
        lineCount: func(files) { return lineCount }
    }
    return f.evaluateResource(resolved, resolver, "test")
}

_gib := func(n) { return n * 1073741824 }

// -------- CPU-path RAM: clamp [16, 128] GiB, scales with input --------

TestCpuMemSequence := func() {
    ast := rf.cpuMem("sequence-features")
    test.isEqual(_gib(16), _eval(ast, "input.tsv", 0, 1000))            // tiny -> floor
    test.isEqual(_gib(128), _eval(ast, "input.tsv", 0, 1000000000))     // huge -> cap
    mid := _eval(ast, "input.tsv", 0, 10000000)
    test.isTrue(mid > _gib(16) && mid < _gib(128), "mid RAM must land inside the clamp window")
}

TestCpuMemEmbedding := func() {
    ast := rf.cpuMem("embedding")
    test.isEqual(_gib(16), _eval(ast, "input.parquet", 0, 0))
    test.isEqual(_gib(128), _eval(ast, "input.parquet", 100 * _gib(1), 0))
}

// -------- CPU-path cores: clamp [4, 16] --------

TestCpuCores := func() {
    seq := rf.cpuCores("sequence-features")
    test.isEqual(4, _eval(seq, "input.tsv", 0, 1000))                   // tiny -> floor
    test.isEqual(16, _eval(seq, "input.tsv", 0, 1000000000))           // huge -> cap

    emb := rf.cpuCores("embedding")
    test.isEqual(4, _eval(emb, "input.parquet", 1000, 0))
    test.isEqual(16, _eval(emb, "input.parquet", 100 * _gib(1), 0))
}

// -------- GPU host RAM: floored at 8 GiB, capped at 32 GiB --------

TestGpuHostMem := func() {
    seq := rf.gpuHostMem("sequence-features")
    test.isEqual(_gib(8), _eval(seq, "input.tsv", 0, 1000))             // tiny -> 8 GiB floor
    test.isEqual(_gib(32), _eval(seq, "input.tsv", 0, 1000000000))     // huge -> 32 GiB cap

    emb := rf.gpuHostMem("embedding")
    test.isEqual(_gib(8), _eval(emb, "input.parquet", 1000, 0))
}

// -------- GPU VRAM: clamp [8, 48] GiB --------

TestGpuVram := func() {
    seq := rf.gpuVram("sequence-features")
    test.isEqual(_gib(8), _eval(seq, "input.tsv", 0, 1000))
    test.isEqual(_gib(48), _eval(seq, "input.tsv", 0, 1000000000))

    emb := rf.gpuVram("embedding")
    test.isEqual(_gib(8), _eval(emb, "input.parquet", 1000, 0))
    test.isEqual(_gib(48), _eval(emb, "input.parquet", 100 * _gib(1), 0))
}

// -------- apply: direct mode wires literal UI values onto the builder --------

_mockBuilder := func() {
    self := undefined
    self = {
        calls: {},
        mem:        func(v)    { self.calls.mem = v; return self },
        cpu:        func(v)    { self.calls.cpu = v; return self },
        gpuMemory:  func(v)    { self.calls.gpuMemory = v; return self },
        memFormula: func(a, o) { self.calls.memFormula = a; return self },
        cpuFormula: func(a, o) { self.calls.cpuFormula = a; return self },
        gpuFormula: func(a, o) { self.calls.gpuFormula = a; return self }
    }
    return self
}

TestApplyDirectNoGpu := func() {
    b := _mockBuilder()
    rf.apply(b, { directPerformanceSettings: true, requireGpu: false, mem: 48, cpu: 6 }, "sequence-features")

    test.isEqual("48GiB", b.calls.mem)
    test.isEqual(6, b.calls.cpu)
    test.isTrue(is_undefined(b.calls.gpuMemory), "no GPU requested when requireGpu is false")
    test.isTrue(is_undefined(b.calls.memFormula), "direct mode must not use a RAM formula")
    test.isTrue(is_undefined(b.calls.cpuFormula), "direct mode must not use a CPU formula")
}
