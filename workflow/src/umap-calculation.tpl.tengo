//tengo:hash_override 16D7E7CE-5B0D-4D2C-A8BF-6909B926FA9D

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
json := import("json")

self.defineOutputs("umapTsVFile", "umapOutput")

self.body(func(args) {
    // Input parameters (shared)
    umap_neighbors := args.umap_neighbors
    umap_min_dist := args.umap_min_dist
    inputMode := is_undefined(args.inputMode) ? "sequence-features" : args.inputMode
    // When false (default), RAM/CPU are derived from input file size via
    // exec.formula and the manual args below are ignored. When true, the
    // workflow uses the static args.mem / args.cpu / args.requireGpu /
    // args.gpuMemory values from the UI exactly as before.
    directPerformanceSettings := !is_undefined(args.directPerformanceSettings) && args.directPerformanceSettings

    // GPU intent: in direct mode the user controls requireGpu; in formula
    // mode we always try GPU and let `exec.hasGpu` drop the request on
    // backends without GPU support.
    requireGpu := directPerformanceSettings ? args.requireGpu : true
    useGpu := requireGpu && exec.hasGpu

    formula := exec.formula

    // ====================================================================
    // Resource setup
    // ====================================================================

    builder := exec.builder().
        software(assets.importSoftware("@platforma-open/milaboratories.clonotype-space.umap:main"))

    if directPerformanceSettings {
        // -------- Direct mode: literal RAM / CPU values from the UI --------
        // The user explicitly opted out of the formula via the "Set
        // performance settings directly" checkbox, so do not second-guess
        // them: pass args.mem and args.cpu through unchanged on both the
        // CPU and the GPU path. If they want a lean GPU-host allocation
        // they can type it; if they want symmetric CPU+GPU sizing for
        // benchmarking they can type that too.
        builder = builder.
            mem(string(args.mem) + "GiB").
            cpu(args.cpu)

        if useGpu {
            // 16 GiB fallback when the user leaves the GPU memory field empty.
            effectiveGpuMemory := is_undefined(args.gpuMemory) ? 16 : args.gpuMemory
            builder = builder.gpuMemory(string(effectiveGpuMemory) + "GiB")
        }
    } else {
        // -------- Formula mode: derive RAM / CPU from input clonotype count --------
        // RAM and CPU are dominated by N (number of clonotypes). On the
        // sequence-features path we drive the formula off f.lineCount("input")
        // because the TSV is one row per clonotype — lineCount gives an exact
        // N. On the embedding path the input is a binary long-format parquet,
        // where the SDK's lineCount is unsupported (only line-oriented text
        // formats are accepted), so we fall back to f.size("input"), which
        // scales linearly with N × D anyway.
        //
        // Per-clonotype multipliers come from docs/resource-formula-analysis.md.

        memAst := undefined
        cpuAst := undefined
        staticMemGiB := 0
        staticCpu := 0

        if inputMode == "embedding" {
            fileSize := formula.size("input")
            if useGpu {
                // Host work: polars read_parquet → dense float32 N×D matrix +
                // np.unique dedup copy. Heavy compute (cuML PCA, cuML UMAP)
                // lives in VRAM, so host RAM is dominated by the matrix.
                // ~6× compressed-parquet size empirically.
                memAst = formula.clamp(
                    formula.add(formula.gib(2), formula.mul(fileSize, 6)),
                    formula.gib(4),
                    formula.gib(16)
                )
                staticMemGiB = 8
                staticCpu = 1
            } else {
                // Dense matrix + dedup copy + sklearn PCA (materialises a
                // centered copy) + sklearn UMAP KNN graph. ~12× file size.
                memAst = formula.clamp(
                    formula.add(formula.gib(8), formula.mul(fileSize, 12)),
                    formula.gib(16),
                    formula.gib(128)
                )
                // CPU: 1 core per ~4 GiB of parquet, floored at 4 (PCA/UMAP
                // parallelism), capped at 16 (returns diminish past that).
                cpuAst = formula.clamp(
                    formula.divCeil(fileSize, formula.gib(4)),
                    4,
                    16
                )
                staticMemGiB = 64
                staticCpu = 8
            }
        } else {
            // sequence-features path: one TSV row per clonotype → exact N.
            N := formula.lineCount("input")
            if useGpu {
                // Host work: polars DataFrame (~100 B per row) + sparse k-mer
                // CSR (~400 B per row, transferred to VRAM). Heavy compute
                // (cuML SVD/UMAP) lives in VRAM. ~1 KiB per clonotype on host.
                memAst = formula.clamp(
                    formula.add(formula.gib(2), formula.mul(N, 1024)),
                    formula.gib(4),
                    formula.gib(16)
                )
                staticMemGiB = 8
                staticCpu = 1
            } else {
                // CPU path: polars DF + sparse k-mer matrix (fit-sample capped
                // at 200 k) + TruncatedSVD + sklearn UMAP fit on 100 k sample
                // + chunked transform (50 k/chunk). Peak ≈ 4 KiB per clonotype
                // on top of an 8 GiB Python/polars/numpy/scipy base.
                memAst = formula.clamp(
                    formula.add(formula.gib(8), formula.mul(N, 4096)),
                    formula.gib(16),
                    formula.gib(128)
                )
                // CPU: 1 core per 250 000 clonotypes — k-mer counting
                // parallelises perfectly across cores; SVD/UMAP are largely
                // single-thread. Floored at 4, capped at 16.
                cpuAst = formula.clamp(
                    formula.divCeil(N, 250000),
                    4,
                    16
                )
                staticMemGiB = 64
                staticCpu = 8
            }
        }
    }

    if inputMode == "embedding" {
        // Embedding feature path: main.py reads the exported Parquet matrix instead of counting k-mers
        // (--encoding embedding), then runs centered PCA-95% -> L2-normalize -> Euclidean UMAP.
        builder = builder.
            addFile("embedding.parquet", args.embeddingMatrix).
            arg("--encoding").arg("embedding").
            arg("--matrix").arg("embedding.parquet").
            arg("--key-col").arg(args.keyCol).
            arg("--dim-col").arg(args.dimCol).
            arg("--value-col").arg(args.valueCol).
            arg("-u").arg("umap.tsv").
            arg("--umap-neighbors").arg(string(umap_neighbors)).
            arg("--umap-min-dist").arg(string(umap_min_dist)).
            arg("--n-jobs").argExpr("{system.cpu}")

        // Embedding model: logged to the processing log for provenance. Undefined if the column
        // lacks the domain key — omit the flag rather than pass an empty string.
        if !is_undefined(args.embeddingModel) {
            builder = builder.arg("--embedding-model").arg(args.embeddingModel)
        }
    } else {
        alphabet := args.alphabet

        // Calculate k-mer size based on alphabet
        kmerSize := 3 // default for aminoacid
        if alphabet == "nucleotide" {
            kmerSize = 6
        }
        encoding := "kmer"

        // Short-peptide override: when the input is peptide-mode AND the shortest
        // peptide is below 10 aa
        isPeptide := is_undefined(args.isPeptide) ? false : args.isPeptide
        if isPeptide && !is_undefined(args.minPeptideLength) {
            minLen := int(json.decode(string(args.minPeptideLength.getData())).min_len)
            if minLen < 10 {
                kmerSize = 2
                encoding = "pos-kmer"
            }
        }

        // Note: --seq-col-start "sequence" will match all columns starting with "sequence"
        // (sequence.TRA, sequence.TRB, sequence_0, etc.)
        builder = builder.
            addFile("sequences.tsv", args.umapTable).
            arg("-i").arg("sequences.tsv").
            arg("-c").arg("sequence").
            arg("-u").arg("umap.tsv").
            arg("--umap-neighbors").arg(string(umap_neighbors)).
            arg("--umap-min-dist").arg(string(umap_min_dist)).
            arg("--alphabet").arg(alphabet).
            arg("--k-mer-size").arg(string(kmerSize)).
            arg("--encoding").arg(encoding).
            arg("--n-jobs").argExpr("{system.cpu}")
    }

    // UMAP software execution
    umapClones := builder.
        saveFile("umap.tsv").
        saveFile("skipped_clonotypes_summary.txt").
        saveStdoutStream().
        // saveStdoutContent().
        cache(24 * 60 * 60 * 1000).
        run()

    // Get stdout output and UMAP file now while we have the raw exec object
    umapOutput := umapClones.getStdoutStream()
    umapTsVFile := umapClones.getFile("umap.tsv")

    return {
        umapTsVFile: umapTsVFile,
        umapOutput: umapOutput
    }
})
