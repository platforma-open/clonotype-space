//tengo:hash_override 16D7E7CE-5B0D-4D2C-A8BF-6909B926FA9D

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
json := import("json")

self.defineOutputs("umapTsVFile", "umapOutput")

// Pick GPU VRAM (GiB) from input row count. Derived from the empirical
// peak-VRAM model (SVD U-matrix + cuML UMAP KNN scratch + CUDA context):
//   peak ≈ 2 + 5·N/1e6 GiB; safe ≈ 2·peak.
// Rounded up to common GPU classes so the scheduler can match a real node:
//   T4 (16 GiB), A10G/L4 (24 GiB), A6000/L40 (48 GiB), top-tier (60+ GiB).
pickGpuMemoryGiB := func(rows) {
    if rows <= 250000 { return 8 }
    if rows <= 1000000 { return 16 }
    if rows <= 2500000 { return 24 }
    if rows <= 6000000 { return 48 }
    return 60
}

self.body(func(args) {
    // Input parameters
    umapTable := args.umapTable
    umap_neighbors := args.umap_neighbors
    umap_min_dist := args.umap_min_dist
    alphabet := args.alphabet
    mem := args.mem
    cpu := args.cpu
    requireGpu := args.requireGpu

    // Auto-size GPU memory from input cardinality (computed by the row-count
    // sub-template). `rowCount` is a tiny ndjson resource: {"n_rows": N}.
    rows := int(json.decode(string(args.rowCount.getData())).n_rows)
    gpuMemoryGiB := pickGpuMemoryGiB(rows)

    // Calculate k-mer size based on alphabet
    kmerSize := 3 // default for aminoacid
    if alphabet == "nucleotide" {
        kmerSize = 6
    }
    encoding := "kmer"

    // Short-peptide override: when the input is peptide-mode AND the shortest
    // peptide is below 10 aa
    isPeptide := is_undefined(args.isPeptide) ? false : args.isPeptide
    if isPeptide && !is_undefined(args.minPeptideLength) {
        minLen := int(json.decode(string(args.minPeptideLength.getData())).min_len)
        if minLen < 10 {
            kmerSize = 2
            encoding = "pos-kmer"
        }
    }

    // UMAP software execution.
    //
    // GPU request is gated on exec.hasGpu so the block still works on backends
    // without GPU support (.gpuMemory() against a no-GPU backend is a permanent
    // error). The software itself probes for CuPy/cuML at runtime and falls
    // back to the CPU path if the GPU isn't usable, so dropping the request on
    // a CPU-only backend just means we land on the existing CPU code path.
    //
    // Note: --seq-col-start "sequence" will match all columns starting with "sequence"
    // (sequence.TRA, sequence.TRB, sequence_0, etc.)
    umapBuilder := exec.builder().
        software(assets.importSoftware("@platforma-open/milaboratories.clonotype-space.umap:main")).
        mem(string(mem) + "GiB").
        cpu(cpu)

    if requireGpu && exec.hasGpu {
        umapBuilder = umapBuilder.gpuMemory(string(gpuMemoryGiB) + "GiB")
    }

    umapClones := umapBuilder.
        addFile("sequences.tsv", umapTable).
        arg("-i").arg("sequences.tsv").
        arg("-c").arg("sequence").
        arg("-u").arg("umap.tsv").
        arg("--umap-neighbors").arg(string(umap_neighbors)).
        arg("--umap-min-dist").arg(string(umap_min_dist)).
        arg("--alphabet").arg(alphabet).
        arg("--k-mer-size").arg(string(kmerSize)).
        arg("--encoding").arg(encoding).
        arg("--n-jobs").arg(string(cpu)).
        saveFile("umap.tsv").
        saveFile("skipped_clonotypes_summary.txt").
        saveStdoutStream().
        // saveStdoutContent().
        cache(24 * 60 * 60 * 1000).
        run()

    // Get stdout output and UMAP file now while we have the raw exec object
    umapOutput := umapClones.getStdoutStream()
    umapTsVFile := umapClones.getFile("umap.tsv")

    return {
        umapTsVFile: umapTsVFile,
        umapOutput: umapOutput
    }
})

